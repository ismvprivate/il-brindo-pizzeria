# =============================================================
# IL BRINDO PIZZERIA — Environment Variables (EXAMPLE)
# =============================================================
# This file is SAFE to commit to GitHub — it contains no real values.
# Copy this file, rename the copy to .env, and fill in the real values.
# On Netlify, paste each variable into Site Settings > Environment Variables.
# =============================================================

# Callmebot — WhatsApp notifications to the owner
CALLMEBOT_PHONE=
CALLMEBOT_API_KEY=

# EmailJS — customer confirmation/rejection emails
EMAILJS_SERVICE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_TEMPLATE_CONFIRM=
EMAILJS_TEMPLATE_REJECT=

# Restaurant info is hardcoded in the functions (not secrets — public info on the website)
